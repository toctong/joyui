{
  "name": "joyui",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "catalog:gen": "node ./scripts/generate-catalog.mjs && node ./scripts/generate-cli-examples.mjs",
    "registry:gen": "pnpm catalog:gen && node ./scripts/generate-registry.mjs",
    "docs:npm-imports": "node ./scripts/rewrite-docs-npm.mjs && node ./scripts/rewrite-docs-npm-pass2.mjs && node ./scripts/rewrite-docs-imports-fill.mjs",
    "sot:flip": "node ./scripts/flip-source-of-truth.mjs",
    "registry:build": "pnpm registry:gen && pnpm --filter @joyui/react registry:build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm test && pnpm build && changeset publish",
    "release:publish": "pnpm catalog:gen && pnpm --filter @joyui/react build && pnpm --filter @joyui/cli build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
