{
  "name": "@joyui/react",
  "version": "0.3.0",
  "description": "JoyUI — React + Tailwind CSS v4 component library with built-in design tokens and component CSS",
  "license": "MIT",
  "author": "JoyUI",
  "homepage": "https://joyui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toctong/joyui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/toctong/joyui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "react-aria",
    "design-system",
    "joyui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./format": {
      "types": "./dist/lib/format.d.ts",
      "import": "./dist/lib/format.js",
      "require": "./dist/lib/format.cjs"
    },
    "./composer": {
      "types": "./dist/composer.d.ts",
      "import": "./dist/composer.js",
      "require": "./dist/composer.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./styles.css": "./src/styles/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./typography.css": "./src/styles/typography.css",
    "./components.css": "./src/styles/components.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "barrel": "node ./scripts/generate-barrel.mjs",
    "sync": "node ./scripts/generate-barrel.mjs",
    "build": "node ./scripts/generate-barrel.mjs && tsup && node ./scripts/copy-styles.mjs",
    "prepack": "pnpm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/check-tokens.mjs",
    "registry:build": "node ./scripts/build-registry.mjs"
  },
  "peerDependencies": {
    "@tiptap/extension-mention": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.0.0",
    "jsbarcode": "^3.0.0",
    "qrcode": "^1.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tippy.js": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "@tiptap/extension-mention": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "tippy.js": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "jsbarcode": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.174",
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.170",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "motion": "^12.43.0",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@tiptap/extension-mention": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.15.32",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsbarcode": "^3.12.3",
    "jsdom": "^31.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tippy.js": "^6.3.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
