{
  "name": "@joyui/react",
  "version": "0.1.5",
  "description": "JoyUI — React + Tailwind CSS v4 component library",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./format": {
      "types": "./dist/lib/format.d.ts",
      "import": "./dist/lib/format.js",
      "require": "./dist/lib/format.cjs"
    },
    "./composer": {
      "types": "./dist/composer.d.ts",
      "import": "./dist/composer.js",
      "require": "./dist/composer.cjs"
    },
    "./styles.css": "./src/styles/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./typography.css": "./src/styles/typography.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "sync": "node ./scripts/sync-from-docs.mjs",
    "build": "node ./scripts/sync-from-docs.mjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "registry:build": "node ./scripts/build-registry.mjs"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.0.0",
    "@remixicon/react": "^4.0.0",
    "@tanstack/react-table": "^8.0.0 || ^9.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@tiptap/extension-mention": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.0.0",
    "dayjs": "^1.11.0",
    "lucide-react": ">=0.400.0",
    "motion": "^12.0.0 || ^14.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-aria-components": "^1.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tippy.js": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@internationalized/date": { "optional": true },
    "@tanstack/react-table": { "optional": true },
    "@tanstack/react-virtual": { "optional": true },
    "@tiptap/extension-mention": { "optional": true },
    "@tiptap/extension-placeholder": { "optional": true },
    "@tiptap/pm": { "optional": true },
    "@tiptap/react": { "optional": true },
    "@tiptap/starter-kit": { "optional": true },
    "@tiptap/suggestion": { "optional": true },
    "dayjs": { "optional": true },
    "lucide-react": { "optional": true },
    "motion": { "optional": true },
    "recharts": { "optional": true },
    "tippy.js": { "optional": true }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-mention": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.525.0",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tippy.js": "^6.3.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
