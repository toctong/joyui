{
  "name": "@joyui/cli",
  "version": "0.2.0",
  "description": "JoyUI CLI — npm-first init, optional source add, MCP server, and agent skill",
  "license": "MIT",
  "author": "JoyUI",
  "homepage": "https://joyui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toctong/joyui.git",
    "directory": "packages/cli"
  },
